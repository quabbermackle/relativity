   "source": [
    "Terminology:\n",
    "\n",
    "an \"upstairs index\" is called \"contravariant\";\n",
    "a \"downstairs\" index is called \"covariant\"\n",
    "\n",
    "in S^alpha_beta_gamma,\n",
    "alpha is a contravariant index,\n",
    "while beta and gamma are covariant"
   ]
  }
 ],
